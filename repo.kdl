schema-version 1
name "Desktop"

// renovate: datasource=github-releases depName=tectonic-os/tectonic
tect-version "0.6.6" sha256="f5dde99cada115c4f0af6d8b0a3cd5e3a80637dedf66b6de4537db6cf9726835"

workflows at="12:30" publish="scheduled" {
    base-sig-probe
    build
    build-disk
    cleanup-registry
    smoke-test
}

sources {
    tectonic-os {
        pin {
            unpinned "This is the trusted source for modules"
            version "main"
            url "https://github.com/tectonic-os/modules/archive/refs/heads/{version}.tar.gz"
        }
    }
}
