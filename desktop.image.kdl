image {
    name "Desktop"
    conforms "standard"
    url "https://github.com/tectonic-os/desktop"
    issues-url "https://github.com/tectonic-os/desktop/issues"
    description "A KDE Plasma workstation on fedora-bootc"
    keywords "bootc" "fedora" "kde" "plasma" "desktop"
    logo-url "https://github.com/tectonic-os.png"

    base "quay.io/fedora/fedora-bootc:44" {
        family "fedora"
        provides "rechunking" "initramfs-generation" "selinux-policy"
        signed #false
    }

    flavours {
        dx
    }

    modules {
        source "tectonic-os" {
            module "fedora-family/dnf"
            module "fedora-family/workstation-debloat"
            module "just/runner"
            module "boot/os-prober"
            module "updates/signature-policy"
            module "updates/auto-updates"
            module "just/system-scripts"
            module "flatpak/client"
            module "tools/brew"
            module "tools/cli"
            module "hardening/coredumps"
            module "hardening/login-policy"
            module "hardening/hardened-malloc"
            module "hardening/sudo-hardening"
            module "boot/plymouth"
            module "desktop/kde"
            module "flatpak/bazaar"
            module "fedora-family/media-codecs"
            module "tect"
        }

        flavour "dx" {
            source "tectonic-os" {
                module "tools/dev"
                module "virt/podman"
                module "virt/libvirt"
                module "tools/vscodium"
            }
        }
    }
}
