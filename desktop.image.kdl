image {
    name "Desktop"
    conforms "standard"
    url "https://github.com/tectonic-os/desktop"
    issues-url "https://github.com/tectonic-os/desktop/issues"
    description "A KDE Plasma workstation on fedora-bootc"
    keywords "bootc" "fedora" "kde" "plasma" "desktop"
    logo-url "https://github.com/tectonic-os.png"

    base "quay.io/fedora/fedora-bootc:44" {
        family "fedora"
        provides "rechunking" "initramfs-generation" "mac-policy"
        signed #false
    }

    flavours {
        dx
    }

    modules {
        source "tectonic-os" {
            module "fedora-family"
            module "just"
            module "bootloader"
            module "signature-policy"
            module "auto-updates"
            module "system-just-scripts"
            module "flatpak"
            module "brew"
            module "cli-tools"
            module "hardening/coredumps"
            module "hardening/login-policy"
            module "hardening/hardened-malloc"
            module "hardening/sudo-hardening"
            module "kde-desktop"
            module "bazaar"
            module "media-codecs"
        }

        flavour "dx" {
            source "tectonic-os" {
                module "dev-tools"
                module "podman"
                module "libvirt"
                module "vscodium"
            }
        }
    }
}
